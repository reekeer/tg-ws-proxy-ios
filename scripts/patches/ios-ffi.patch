+#[unsafe(no_mangle)]
+pub extern "C" fn GetCfProxyDomains() -> *mut c_char {
+    if CFPROXY.read().domains.is_empty() {
+        cfproxy::init_cfproxy_domains();
+    }
+    let domains = CFPROXY.read().domains.join("\n");
+    CString::new(domains).unwrap_or_default().into_raw()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn RefreshCfProxyDomains() -> c_int {
+    if runtime().block_on(cfproxy::try_refresh_cfproxy_domains()) {
+        1
+    } else {
+        0
+    }
+}
